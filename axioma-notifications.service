[Unit]
Description=AXIOMA Notification Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=axioma
WorkingDirectory=/home/axioma/notifications
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/axioma/logs/notifications.log
StandardError=append:/home/axioma/logs/notifications.log

[Install]
WantedBy=multi-user.target
