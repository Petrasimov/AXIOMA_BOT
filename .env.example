# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=токен_тг_бота

# Чат администраторов: сюда падают обращения в поддержку и резюме.
# Для супергруппы ID отрицательный, вида -1001234567890
ADMIN_CHAT_ID=0

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app_user:пароль@localhost:5432/axioma

# ── Уведомления ──────────────────────────────────────────────────────────────
# Интервал проверки новых возможностей, секунды
CHECK_INTERVAL=60
# Минимальный промежуток между уведомлениями по одной связке, часы
COOLDOWN_HOURS=1
# Максимум уведомлений одному пользователю за один цикл
MAX_NOTIFICATIONS_PER_CYCLE=5

# ── Ссылки ───────────────────────────────────────────────────────────────────
SCANNER_URL=https://axioma-scan.ru

# ── NOWPayments (Задача 5) ───────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=
SUBSCRIPTION_PRICE_USD=5
PAYMENT_TIMEOUT_MINUTES=30
