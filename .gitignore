# ─── Секреты ─────────────────────────────────────────────────────────────────
# .env содержит токен бота, пароль от БД и ключ NOWPayments.
# Файл НИКОГДА не должен попадать в репозиторий.
.env
.env.*
!.env.example

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Виртуальные окружения
.venv/
venv/
env/
ENV/

# ─── Тесты и покрытие ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Редакторы и ОС ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Логи и временное ────────────────────────────────────────────────────────
*.log
logs/
*.pid
*.bak